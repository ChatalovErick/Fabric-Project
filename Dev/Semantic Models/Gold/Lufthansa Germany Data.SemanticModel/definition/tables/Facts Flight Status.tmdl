table 'Facts Flight Status'
	lineageTag: 90865055-6a68-4c75-8288-f6fc4bf3c178
	sourceLineageTag: [Gold].[lufthansadata_germany_flight_status]

	measure 'Total Flights' = COUNTROWS('Facts Flight Status')
		formatString: 0
		lineageTag: 4da38dba-d0fc-4a70-b4fd-ee4e7cf01c72

		changedProperty = Name

	measure 'Avg Arrival Delay (Min)' = ```
			
			VAR TotalDelayMinutes = 
			    SUMX(
			        'Facts Flight Status',
			        IF(
			            'Facts Flight Status'[ActualArrivalTime] > 'Facts Flight Status'[ScheduledArrivalTime],
			            DATEDIFF('Facts Flight Status'[ScheduledArrivalTime], 'Facts Flight Status'[ActualArrivalTime], MINUTE),
			            0
			        )
			    )
			RETURN
			AVERAGEX(
			    'Facts Flight Status',
			    DATEDIFF('Facts Flight Status'[ScheduledArrivalTime], 'Facts Flight Status'[ActualArrivalTime], MINUTE)
			)
			```
		lineageTag: fa420381-1cf9-4b70-9ec0-287cb4a2c4e5

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Arrival Status Count' = COUNT('Facts Flight Status'[ArrivalStatus])
		formatString: 0
		lineageTag: 5f1ae6aa-aa58-4d0d-a60d-ab90fe1b215a

		changedProperty = Name

	measure 'Avg Arrival Delay (Late Only)' =
			
			AVERAGEX(
			    'Facts Flight Status',
			    MAX(0, DATEDIFF('Facts Flight Status'[ScheduledArrivalTime], 'Facts Flight Status'[ActualArrivalTime], MINUTE))
			)
		lineageTag: 7c156952-e965-4020-817b-a46234f9df60

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Departure Delay (Min)' = ```
			
			VAR TotalDelayMinutes = 
			    SUMX(
			        'Facts Flight Status',
			        IF(
			            'Facts Flight Status'[ActualDepartureTime] > 'Facts Flight Status'[ActualDepartureTime],
			            DATEDIFF('Facts Flight Status'[ActualDepartureTime], 'Facts Flight Status'[ActualDepartureTime], MINUTE),
			            0
			        )
			    )
			RETURN
			AVERAGEX(
			    'Facts Flight Status',
			    DATEDIFF('Facts Flight Status'[ActualDepartureTime], 'Facts Flight Status'[ActualDepartureTime], MINUTE)
			)
			```
		lineageTag: 12896550-23b5-4602-807d-5bf093c54e1f

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Departure Delay (Late Only)' =
			
			AVERAGEX(
			    'Facts Flight Status',
			    MAX(0, DATEDIFF('Facts Flight Status'[ScheduledDepartureTime], 'Facts Flight Status'[ActualDepartureTime], MINUTE))
			)
		formatString: 0
		lineageTag: 5a6f34f1-ea6b-4a27-a0a2-73fc115b43bf

		changedProperty = Name

	measure 'Departure Status Count' = COUNT('Facts Flight Status'[DepartureStatus])
		formatString: 0
		lineageTag: 450acd4d-f01d-4fcf-96be-2a596a6b6c1c

		changedProperty = Name

	measure 'Total Arrivals for Selected Airport' =
			
			CALCULATE(
			    COUNTROWS('Facts Flight Status'),
			    USERELATIONSHIP('Facts Flight Status'[Destination], 'Dim Airports'[AirportCode])
			)
		formatString: 0
		lineageTag: 08d3f1f4-9420-4159-a39f-8b40f28a107b

		changedProperty = Name

	measure 'Total Departures for Selected Airport' =
			
			CALCULATE(
			    COUNTROWS('Facts Flight Status'),
			    USERELATIONSHIP('Facts Flight Status'[Origin], 'Dim Airports'[AirportCode])
			)
		formatString: 0
		lineageTag: 6b6ea4f2-f5c7-40aa-a396-f48b56349496

		changedProperty = Name

	measure 'Avg Travel Time per Route' = ```
			
			AVERAGEX(
			    'Facts Flight Status',
			    DATEDIFF(
			        'Facts Flight Status'[ActualDepartureTime], 
			        'Facts Flight Status'[ActualArrivalTime], 
			        MINUTE
			    )
			)
			```
		lineageTag: 78cc4c59-ea2c-42e7-9ca5-c89e2d6e5c07

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

