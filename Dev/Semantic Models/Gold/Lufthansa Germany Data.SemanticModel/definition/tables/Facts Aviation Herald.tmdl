		changedProperty = Name

	measure 'Total Crashes' = ```
			
			CALCULATE(
			    COUNT('Facts Aviation Herald'[Type]), 
			    'Facts Aviation Herald'[Type] = "Crash"
			)
			```
		formatString: 0
		lineageTag: 0dc58421-19a1-415e-8910-0008d05a2620

