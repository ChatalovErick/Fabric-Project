	measure 'Count of Types' = COUNT('Facts Aviation Herald'[Type])
		formatString: 0
		lineageTag: 350d1b28-6a62-4873-81e2-214b64446613

		changedProperty = Name

	measure 'Total Events' = COUNTROWS('Facts Aviation Herald')
		formatString: 0
